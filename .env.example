# --- Ollama ---------------------------------------------------------------
# Base URL of the Ollama server. Defaults to a local install.
OLLAMA_HOST=http://localhost:11434
# Model tag the Agno agent should call. `minimax-m3:cloud` is the default.
OLLAMA_MODEL=minimax-m3:cloud
# Set this when pointing the agent at Ollama Cloud; leave empty for a local server.
# OLLAMA_API_KEY=
# Optional request timeout in seconds.
# OLLAMA_TIMEOUT=60

# --- Laya local Router ----------------------------------------------------
# Preload all Laya checkpoints at startup (recommended for production).
LAYA_PRELOAD=false
# Which checkpoint to default to when the text is Latin-script and ambiguous.
LAYA_DEFAULT=english
# Torch device for Laya inference: auto, cpu, cuda, mps, xpu.
LAYA_DEVICE=auto

# --- Laya MCP server (stdio) ----------------------------------------------
# Used by Agno's MCPTools to talk to Laya.
LAYA_MCP_ENABLED=true
LAYA_MCP_COMMAND=laya-mcp-server

# --- LLM behaviour --------------------------------------------------------
# Optional sampling temperature for the Ollama model.
# LLM_TEMPERATURE=0.2
LLM_MARKDOWN=true

# --- Detection tuning -----------------------------------------------------
# Threshold above which P(phishing) counts as phishing (0.0–1.0).
PHISHING_THRESHOLD=0.5

# --- AgentOS server (REST/MCP) -------------------------------------------
# Host/port the REST API binds to. Port 7777 matches the AgentOS default.
AGENTOS_HOST=0.0.0.0
AGENTOS_PORT=7777
# SQLite file that stores sessions, traces, and default AgentOS state.
AGENTOS_DB_PATH=.data/emaildetective.db
# Auto-reload on code changes (dev only).
AGENTOS_RELOAD=false
